# Web server port
WEB_PORT=3001

# IANA time zone used for displayed message times (for example: Asia/Colombo)
TIME_ZONE=Asia/Colombo

# Password for dashboard login
AUTH_PASSWORD=Hello123

# Set to 'production' for secure/https-only cookies
NODE_ENV=production

# Set to 'true' if running behind a reverse proxy (Caddy/Nginx)
TRUST_PROXY=true
# Comma-separated list of trusted proxy IPs
TRUSTED_PROXIES=127.0.0.1,::1

